    },
    {
      "id": "LyibuFTw_GC14TQCAy-S1",
      "type": "text",
      "x": 387.3766565379232,
      "y": 4256.025222565165,
      "width": 575.6995849609375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNO",
      "roundness": null,
      "seed": 1785621739,
      "version": 582,
      "versionNonce": 133131723,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788881138230,
      "link": null,
      "locked": false,
      "text": "Can keep same database with different users for both\nmicroservices, admin user having access to Template and\nProviders tables, notification microservice having the read-\nonly access to those tables and write access to\nnotifications table.\nA design call where we can reduce the cost of different\nmechanisms like shared Redis by keeping single DB, but\nhuge traffic requires caching, and then this architecture\nmakes more sense.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "QtqRwplf_FFuNvhy7pdBy",
      "originalText": "Can keep same database with different users for both microservices, admin user having access to Template and Providers tables, notification microservice having the read-only access to those tables and write access to notifications table.\nA design call where we can reduce the cost of different mechanisms like shared Redis by keeping single DB, but huge traffic requires caching, and then this architecture makes more sense.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hLIE46DBqpzml8mMseH7-",
      "type": "text",
      "x": 507.7065249938053,
      "y": 5692.034007329756,
      "width": 403.419677734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNQ",
      "roundness": null,
      "seed": 691037920,
      "version": 228,
      "versionNonce": 429464226,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788939335077,
      "link": null,
      "locked": false,
      "text": "The scheduler can increase the frequency\nand limit as per transactional traffic",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The scheduler can increase the frequency\nand limit as per transactional traffic",
      "autoResize": true,
      "lineHeight": 1.25
    },
