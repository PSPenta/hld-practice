    {
      "id": "FotrP7YXBfFqQ-6IVu5NQ",
      "type": "text",
      "x": 2632.9520574057233,
      "y": 1647.4033782037732,
      "width": 401.2197265625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9BG",
      "roundness": null,
      "seed": 669590668,
      "version": 155,
      "versionNonce": 1966432180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116506,
      "link": null,
      "locked": false,
      "text": "Each broker can have multiple topics\ni.e. SMS, WhatsApp, Email, Push, Webhook",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each broker can have multiple topics\ni.e. SMS, WhatsApp, Email, Push, Webhook",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NnEgaBx7vB6a_1o4RicRK",
      "type": "text",
      "x": 1828.474166426933,
      "y": 704.6101498830467,
      "width": 1137.099365234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9BV",
      "roundness": null,
      "seed": 183284492,
      "version": 829,
      "versionNonce": 1810212517,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767772197038,
      "link": null,
      "locked": false,
      "text": "Template table will consist of templates created.\nIt will have pre-defined format of SMS, WhatsApp, Email or Push notification format.\nJust the place-holders that will be taken from the client will be replaced.\nIn case of webhook, it will have the webhook URL pre-defined along with the parameters.\nUser just need to pass the template ID of that webhook along with the placeholders and the API will be triggered.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Template table will consist of templates created.\nIt will have pre-defined format of SMS, WhatsApp, Email or Push notification format.\nJust the place-holders that will be taken from the client will be replaced.\nIn case of webhook, it will have the webhook URL pre-defined along with the parameters.\nUser just need to pass the template ID of that webhook along with the placeholders and the API will be triggered.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sEi_mhABPsBhLPO_TMddL",
      "type": "text",
      "x": 3364.0239539050162,
      "y": 1744.1410567772327,
      "width": 840.1793823242188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9D8",
      "roundness": null,
      "seed": 326791564,
      "version": 387,
      "versionNonce": 1817578149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767773876629,
      "link": null,
      "locked": false,
      "text": "The individual Consumer group will be responsible for sending all types of notifications\ni.e. SMS, Email, WhatsApp, Webhook, etc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The individual Consumer group will be responsible for sending all types of notifications\ni.e. SMS, Email, WhatsApp, Webhook, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    },
