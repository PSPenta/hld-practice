    {
      "id": "FotrP7YXBfFqQ-6IVu5NQ",
      "type": "text",
      "x": 2632.9520574057233,
      "y": 1647.4033782037732,
      "width": 401.2197265625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
