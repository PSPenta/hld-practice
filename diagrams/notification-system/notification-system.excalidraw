      "isDeleted": false,
      "boundElements": [],
      "updated": 1788882389308,
      "link": null,
      "locked": false,
      "text": "1. High availability + eventual consistency\n2. Transaction notification p99: <5s (end-to-end)\n3. Promotional notification p99: <30m\n4. Volume: 50M/day (can consider 10x during festivals/campaigns)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. High availability + eventual consistency\n2. Transaction notification p99: <5s (end-to-end)\n3. Promotional notification p99: <30m\n4. Volume: 50M/day (can consider 10x during festivals/campaigns)",
      "autoResize": true,
      "lineHeight": 1.25
    },
