      "index": "bNR",
      "roundness": null,
      "seed": 922555168,
      "version": 1464,
      "versionNonce": 303254240,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788936330982,
      "link": null,
      "locked": false,
      "text": "Client\n    - id\n    - name\n    - optedChannels []\n    - quota (overall client quota)\n    - throttle (per-min/per-second)\n    - isActive",
