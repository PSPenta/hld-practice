      "boundElements": [],
      "updated": 1767123116506,
      "link": null,
      "locked": false,
      "text": "1. Sending SMS, WhatsApp, Email, Push, webhooks\n2. Types of notifications i.e. Transactional, Promotional, General, etc.\n3. Opt-in/Opt-out for promotional\n4. Configure webhooks for merchants\n5. Batching of promotional notifications",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Sending SMS, WhatsApp, Email, Push, webhooks\n2. Types of notifications i.e. Transactional, Promotional, General, etc.\n3. Opt-in/Opt-out for promotional\n4. Configure webhooks for merchants\n5. Batching of promotional notifications",
      "autoResize": true,
      "lineHeight": 1.25
    },
