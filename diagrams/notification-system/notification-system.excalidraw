    {
      "id": "WA7Ir5IwGDK539qjlxpuS",
      "type": "text",
      "x": 2520.6994203711365,
      "y": 4692.10269345135,
      "width": 382.73783083851526,
      "height": 47.69678626194047,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
