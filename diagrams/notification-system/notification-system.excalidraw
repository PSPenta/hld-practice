      "boundElements": null,
      "updated": 1788941104961,
      "link": null,
      "locked": false,
      "text": "Can consider the Outbox approach where\ninstead of directly publishing\nnotifications into broker, we will maintain\nan Outbox table for Transactional\nnotifications similar to\nPromotionalOutbox that will have no\nlimits in order to make sure transactional\nnotifications are sent at least once.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "z-D3VkV8u9kxjsT0RuI5C",
      "originalText": "Can consider the Outbox approach where instead of directly publishing notifications into broker, we will maintain an Outbox table for Transactional notifications similar to PromotionalOutbox that will have no limits in order to make sure transactional notifications are sent at least once.",
      "autoResize": true,
      "lineHeight": 1.25
    }
