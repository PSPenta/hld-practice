      "isDeleted": false,
      "boundElements": [],
      "updated": 1767852596503,
      "link": null,
      "locked": false,
      "text": "Each broker can have multiple topics\ni.e. SMS, WhatsApp, Email, Push, Webhook",
      "fontSize": 19.078714504776187,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each broker can have multiple topics\ni.e. SMS, WhatsApp, Email, Push, Webhook",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CGsDIxnXF0dedvdUSsG3N",
      "type": "text",
      "x": 1753.2792200016966,
      "y": 3792.7385514429698,
      "width": 1084.7197076434434,
      "height": 119.24196565485119,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bE6",
      "roundness": null,
      "seed": 124406789,
      "version": 1110,
      "versionNonce": 30669733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767852596503,
      "link": null,
      "locked": false,
      "text": "Template table will consist of templates created.\nIt will have pre-defined format of SMS, WhatsApp, Email or Push notification format.\nJust the place-holders that will be taken from the client will be replaced.\nIn case of webhook, it will have the webhook URL pre-defined along with the parameters.\nUser just need to pass the template ID of that webhook along with the placeholders and the API will be triggered.",
      "fontSize": 19.078714504776187,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Template table will consist of templates created.\nIt will have pre-defined format of SMS, WhatsApp, Email or Push notification format.\nJust the place-holders that will be taken from the client will be replaced.\nIn case of webhook, it will have the webhook URL pre-defined along with the parameters.\nUser just need to pass the template ID of that webhook along with the placeholders and the API will be triggered.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UufTq-1nNDav4y3BVSfs0",
      "type": "text",
      "x": 3218.0950201599017,
      "y": 4784.384221019231,
      "width": 801.4771284081485,
      "height": 71.5451793929107,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bE7",
      "roundness": null,
      "seed": 1923908453,
      "version": 762,
      "versionNonce": 1065303813,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767852596503,
      "link": null,
      "locked": false,
      "text": "The individual Consumer group will be responsible for sending all types of notifications\ni.e. SMS, Email, WhatsApp, Webhook, etc.\nIn case of webhook, it will trigger the webhook API and send the .",
      "fontSize": 19.078714504776187,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The individual Consumer group will be responsible for sending all types of notifications\ni.e. SMS, Email, WhatsApp, Webhook, etc.\nIn case of webhook, it will trigger the webhook API and send the .",
      "autoResize": true,
      "lineHeight": 1.25
    },
