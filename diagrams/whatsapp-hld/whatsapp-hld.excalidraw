    {
      "id": "UKVCuTMHG9mjot0hlnvCg",
      "type": "text",
      "x": 40,
      "y": 362.5216489656668,
      "width": 777.8394165039062,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFP",
      "roundness": null,
      "seed": 52539164,
      "version": 213,
      "versionNonce": 1982427300,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768501547097,
      "link": null,
      "locked": false,
      "text": "1. The user should send messages to other users.\n2. The user should send media to other users.\n3. The user can create a group of multiple users and send messages into group.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. The user should send messages to other users.\n2. The user should send media to other users.\n3. The user can create a group of multiple users and send messages into group.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Z02boy-tIfzGy3iW32xM_",
      "type": "text",
      "x": 42.00923040447742,
      "y": 501.1816228858588,
      "width": 384.24383544921875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
