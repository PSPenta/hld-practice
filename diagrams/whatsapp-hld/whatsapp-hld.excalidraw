    },
    {
      "id": "D-0LJhDLs7iRO9Cf3Q_Ij",
      "type": "text",
      "x": 45.02307601119537,
      "y": 569.4493046157222,
      "width": 1141.0792236328125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFR",
      "roundness": null,
      "seed": 264393372,
      "version": 226,
      "versionNonce": 1098422180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768501547097,
      "link": null,
      "locked": false,
      "text": "1. Low latency in chatting when users are online.\n2. Strong consistency even when users are offline (as soon as the user comes online, all messages should be synced).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency in chatting when users are online.\n2. Strong consistency even when users are offline (as soon as the user comes online, all messages should be synced).",
      "autoResize": true,
      "lineHeight": 1.25
    },
