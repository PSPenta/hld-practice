      "isDeleted": false,
      "boundElements": [],
      "updated": 1768501547097,
      "link": null,
      "locked": false,
      "text": "1. User\n2. Groups\n3. Sockets\n4. Chat Service\n5. Local DB (SQLite)\n6. Remote DB (PostgreSQL/DynamoDB)\n7. Availability Service\n8. Sockets Pool (info of servers where user's socket is active)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User\n2. Groups\n3. Sockets\n4. Chat Service\n5. Local DB (SQLite)\n6. Remote DB (PostgreSQL/DynamoDB)\n7. Availability Service\n8. Sockets Pool (info of servers where user's socket is active)",
      "autoResize": true,
      "lineHeight": 1.25
