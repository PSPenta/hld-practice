    {
      "id": "Bmlp1XBY14KlrWK71uOa1",
      "type": "rectangle",
      "x": 2902.020221985277,
      "y": 1701.3758858195847,
      "width": 1441.6287042128865,
      "height": 422.52247543745045,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
