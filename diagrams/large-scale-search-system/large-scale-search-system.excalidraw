      "type": "text",
      "x": 50.18776141110379,
      "y": 1007.5205863636402,
      "width": 546.839599609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
