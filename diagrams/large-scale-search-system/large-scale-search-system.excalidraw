    {
      "id": "rNNO_Or2sJXlA1cYUEjg4",
      "type": "text",
      "x": 50.18776141110379,
      "y": 1007.5205863636402,
      "width": 546.839599609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6V",
      "roundness": null,
      "seed": 1709670763,
      "version": 479,
      "versionNonce": 564856116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116349,
      "link": null,
      "locked": false,
      "text": "1. Low latency search (<200ms).\n2. Very low latency for autocomplete (<50ms).\n3. Highly available system (no single point of failure).\n4. Eventual consistency between index and source data.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency search (<200ms).\n2. Very low latency for autocomplete (<50ms).\n3. Highly available system (no single point of failure).\n4. Eventual consistency between index and source data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
