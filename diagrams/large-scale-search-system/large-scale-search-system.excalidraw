    {
      "id": "BRje_Bv_HN5kVontDpgfr",
      "type": "text",
      "x": 3017.1760320658987,
      "y": 1913.9699896711136,
      "width": 1219.819091796875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7Q",
      "roundness": null,
      "seed": 1553651141,
      "version": 511,
      "versionNonce": 457746740,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116349,
      "link": null,
      "locked": false,
      "text": "Tokeniser Service converts all the texts/strings into tokens (i.e. breaking entire sentence/paragraph into words)\n\n\nIndexing Service maintains inverted index that is a key value pair where keys will be all the tokens and values will be array of\nids of rows in which this token can be found.\n\n\nRanker Service sorts the IDs based on the token occurrences (i.e. an ID with maximum tokens matching will be on top).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tokeniser Service converts all the texts/strings into tokens (i.e. breaking entire sentence/paragraph into words)\n\n\nIndexing Service maintains inverted index that is a key value pair where keys will be all the tokens and values will be array of\nids of rows in which this token can be found.\n\n\nRanker Service sorts the IDs based on the token occurrences (i.e. an ID with maximum tokens matching will be on top).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mx-O6ZgOAIIQwxsb_52sP",
      "type": "text",
      "x": 3077.6149442879223,
      "y": 175.7391088817676,
      "width": 209.87982177734375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
