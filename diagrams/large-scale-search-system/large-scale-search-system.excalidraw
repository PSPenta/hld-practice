    {
      "id": "BIG69fQMBiddLOWT0f7yu",
      "type": "text",
      "x": 44.45597535748766,
      "y": 764.268221948958,
      "width": 673.2994995117188,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
