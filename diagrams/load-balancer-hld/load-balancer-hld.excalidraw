      "link": null,
      "locked": false,
      "text": "The DNS manages domain-server mapping.\nThere can be multiple load balancers distributed across the network.\nDNS manages mapping each LB's IP and can distribute requests\nbased on different routing policies.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The DNS manages domain-server mapping.\nThere can be multiple load balancers distributed across the network.\nDNS manages mapping each LB's IP and can distribute requests\nbased on different routing policies.",
      "autoResize": true,
      "lineHeight": 1.25
    }
