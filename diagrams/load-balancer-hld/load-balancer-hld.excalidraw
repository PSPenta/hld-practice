    },
    {
      "id": "-_80CMyAGBfuBUBw9jOyd",
      "type": "text",
      "x": 40.302351184656345,
      "y": 309.8263523945461,
      "width": 802.5194091796875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7a",
      "roundness": null,
      "seed": 1811266283,
      "version": 482,
      "versionNonce": 833308084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116349,
      "link": null,
      "locked": false,
      "text": "1. It should be able to add and remove servers swiftly.\n2. It should check and maintain the health status of servers.\n3. Incoming load should be distributed across all healthy servers.\n4. Support various routing strategies, i.e., IP-based (L4), route-based (L7), etc.\n5. It should support several load-balancing strategies like round robin, sticky, etc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. It should be able to add and remove servers swiftly.\n2. It should check and maintain the health status of servers.\n3. Incoming load should be distributed across all healthy servers.\n4. Support various routing strategies, i.e., IP-based (L4), route-based (L7), etc.\n5. It should support several load-balancing strategies like round robin, sticky, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
