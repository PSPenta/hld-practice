    },
    {
      "id": "t98u4Iw5J_wOZ3oJV1WNi",
      "type": "text",
      "x": 1364.80805537184,
      "y": 749.4339555483602,
      "width": 616.6595458984375,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAV",
      "roundness": null,
      "seed": 573336331,
      "version": 1028,
      "versionNonce": 1459229611,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767609368089,
      "link": null,
      "locked": false,
      "text": "1. POST /payments/intent\n    Request: {\n        merchantId,\n        amount,\n        clientDetails: {}\n    }\n    Response: {\n        Payment SDK (UI)\n    }\n\n2. Internal (SDK)   POST /payments/initiate\n    Request: {\n        paymentMethod: UPI/CreditCard/DebitCard/NetBanking,\n        transactionId\n    }\n    Response: {\n        status: Created\n    }\n\n\n3. Merchant-specific   POST /webhook/registration\n    Request: {\n        webhookURL,\n        api-key,\n        event: Created/Processing/Completed/Failed/Refunded\n    }\n\n4. Merchant-specific   GET /payments/:transactionId\n\n5. Merchant-specific   POST /payments/:transactionId/refund\n    Request: {\n        type: manualRefund\n        reason: {order_cancelled/double_payment}\n    }\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. POST /payments/intent\n    Request: {\n        merchantId,\n        amount,\n        clientDetails: {}\n    }\n    Response: {\n        Payment SDK (UI)\n    }\n\n2. Internal (SDK)   POST /payments/initiate\n    Request: {\n        paymentMethod: UPI/CreditCard/DebitCard/NetBanking,\n        transactionId\n    }\n    Response: {\n        status: Created\n    }\n\n\n3. Merchant-specific   POST /webhook/registration\n    Request: {\n        webhookURL,\n        api-key,\n        event: Created/Processing/Completed/Failed/Refunded\n    }\n\n4. Merchant-specific   GET /payments/:transactionId\n\n5. Merchant-specific   POST /payments/:transactionId/refund\n    Request: {\n        type: manualRefund\n        reason: {order_cancelled/double_payment}\n    }\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
