    {
      "id": "-5Jgr2PbaAlRkG6-X65Qf",
      "type": "text",
      "x": 52.074324360983155,
      "y": 1261.7066638019678,
      "width": 211.6998291015625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAS",
      "roundness": null,
      "seed": 1267791141,
      "version": 248,
      "versionNonce": 1016698021,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767608956514,
      "link": null,
      "locked": false,
      "text": "1. Clients (Merchants)\n2. Transactions\n3. Customers (Users)\n4. Banks\n5. Payment Sessions\n6. Refunds\n7. Webhooks",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Clients (Merchants)\n2. Transactions\n3. Customers (Users)\n4. Banks\n5. Payment Sessions\n6. Refunds\n7. Webhooks",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jKrhNgeU7e2P3ZNBaD2Do",
      "type": "text",
      "x": 1358.5154287462565,
      "y": 672.3663449480664,
      "width": 231.6439208984375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
