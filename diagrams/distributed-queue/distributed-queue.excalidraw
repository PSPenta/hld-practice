    {
      "id": "I4oSuxR_gV3CVbkacn-02",
      "type": "text",
      "x": 47.89759273322784,
      "y": 531.2847276127686,
      "width": 514.6397094726562,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 897199677,
      "version": 340,
      "versionNonce": 1564479500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116347,
      "link": null,
      "locked": false,
      "text": "1. Approx 1M writes/second and 2M reads/second\n2. Writes should be <100ms, reads should be <500ms\n3. High Durability (multi-AZ)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Approx 1M writes/second and 2M reads/second\n2. Writes should be <100ms, reads should be <500ms\n3. High Durability (multi-AZ)",
      "autoResize": true,
      "lineHeight": 1.25
    },
