      "boundElements": [],
      "updated": 1767123116347,
      "link": null,
      "locked": false,
      "text": "1. produce()\n    {\n        topic: {queueName},\n        data: {<actual_message>}\n    }\n2. consume()\n    {\n        id: {messageId},\n        data: {<actual_message>}\n    }\n3. deleteMessage(messageId)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. produce()\n    {\n        topic: {queueName},\n        data: {<actual_message>}\n    }\n2. consume()\n    {\n        id: {messageId},\n        data: {<actual_message>}\n    }\n3. deleteMessage(messageId)",
      "autoResize": true,
      "lineHeight": 1.25
