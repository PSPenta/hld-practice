    {
      "id": "eZd01ZXudCSlivdOdhgYP",
      "type": "text",
      "x": 41.64514951118758,
      "y": 303.5146528683763,
      "width": 1164.17919921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 1993124915,
      "version": 282,
      "versionNonce": 1889804684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116347,
      "link": null,
      "locked": false,
      "text": "1. Producer should produce the message in a particular topic/queue.\n2. Consumer should be able to read the message from the queue.\n3. Message should not be read by multiple consumers at a same time unless its Pub-Sub queue with multiple subscribers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Producer should produce the message in a particular topic/queue.\n2. Consumer should be able to read the message from the queue.\n3. Message should not be read by multiple consumers at a same time unless its Pub-Sub queue with multiple subscribers.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "97OtV3pjYiSQNrUfzwLUX",
