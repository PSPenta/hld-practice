      "boundElements": [],
      "updated": 1767123116349,
      "link": null,
      "locked": false,
      "text": "TTL for expiry and remove expired keys before\nLRU logic to keep unexpired safe.\n\nIf no expired key, remove least recently used.\n\nEach key when accessed (get or set), pop it up\non top, leaving unaccessed at bottom, so LRU\ncan start removing from bottom",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TTL for expiry and remove expired keys before\nLRU logic to keep unexpired safe.\n\nIf no expired key, remove least recently used.\n\nEach key when accessed (get or set), pop it up\non top, leaving unaccessed at bottom, so LRU\ncan start removing from bottom",
      "autoResize": true,
      "lineHeight": 1.25
    }
