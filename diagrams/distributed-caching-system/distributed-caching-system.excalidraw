    {
      "id": "_eGiaCd7JUXsJTMC23tPv",
      "type": "text",
      "x": 44.34642463609532,
      "y": 717.7081744767511,
      "width": 616.5195922851562,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b46",
      "roundness": null,
      "seed": 1233134123,
      "version": 357,
      "versionNonce": 667422388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116348,
      "link": null,
      "locked": false,
      "text": "1. Low latency on get operations (milliseconds response time).\n2. Highly scalable (adding and removing nodes should be easier).\n3. Eventually consistent behaviour.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency on get operations (milliseconds response time).\n2. Highly scalable (adding and removing nodes should be easier).\n3. Eventually consistent behaviour.",
      "autoResize": true,
      "lineHeight": 1.25
    },
