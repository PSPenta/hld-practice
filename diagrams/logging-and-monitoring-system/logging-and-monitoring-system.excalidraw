      "seed": 1153482397,
      "version": 240,
      "versionNonce": 230632619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767850692557,
      "link": null,
      "locked": false,
      "text": "1. Low-latency search.\n2. High availability > Consistency.\n3. Should handle high write throughput.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low-latency search.\n2. High availability > Consistency.\n3. Should handle high write throughput.",
      "autoResize": true,
      "lineHeight": 1.25
    },
