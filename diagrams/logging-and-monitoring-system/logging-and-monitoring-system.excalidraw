    {
      "id": "Piiu7TZp99WVAbKzzPky4",
      "type": "text",
      "x": 2842.1920753502986,
      "y": 6449.423266738115,
      "width": 613.6596069335938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAJ",
      "roundness": null,
      "seed": 638595027,
      "version": 271,
      "versionNonce": 1271266635,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767850692557,
      "link": null,
      "locked": false,
      "text": "If we use Filebeat, Kafka/Kinesis can be skipped\nBut it would be better to keep it for fan-out needs\nAlso, Filebeat cannot write to more than one source at a time.\nSo, to write in S3 and Logstash together, a stream is needed.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we use Filebeat, Kafka/Kinesis can be skipped\nBut it would be better to keep it for fan-out needs\nAlso, Filebeat cannot write to more than one source at a time.\nSo, to write in S3 and Logstash together, a stream is needed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
