    {
      "id": "Z1b5WRnlxnnenqh2Y7QxK",
      "type": "text",
      "x": 40,
      "y": 1481.2731144234203,
      "width": 1436.0538160388614,
      "height": 71.5451793929107,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEI",
      "roundness": null,
      "seed": 1410862213,
      "version": 755,
      "versionNonce": 18315077,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767852596503,
      "link": null,
      "locked": false,
      "text": "Every consumer will access a respective broker; each broker can have multiple topics.\nIn case of SMS, Email, WhatsApp, Push notifications, we will have 3rd party services integrated, i.e., Kaleyra, Exotel, AWS SES, SendGrid, FCS, APN, etc.\nIn case of Webhook, we willl be directly calling the Webhook API we have configured in the Template table with the parameters we are getting from client.",
      "fontSize": 19.078714504776187,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every consumer will access a respective broker; each broker can have multiple topics.\nIn case of SMS, Email, WhatsApp, Push notifications, we will have 3rd party services integrated, i.e., Kaleyra, Exotel, AWS SES, SendGrid, FCS, APN, etc.\nIn case of Webhook, we willl be directly calling the Webhook API we have configured in the Template table with the parameters we are getting from client.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iVQJfwMrGjZESsMrp3vMr",
      "type": "text",
      "x": 845.4642578374462,
      "y": 1042.8798818483629,
      "width": 517.5670154149276,
      "height": 71.5451793929107,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEJ",
      "roundness": null,
      "seed": 1422799845,
      "version": 472,
      "versionNonce": 1813137061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767852596503,
      "link": null,
      "locked": false,
      "text": "Each topic will have retries and DLQ\nIf msg is not sent in 1st attempt, it will retry\nAfter all configured retry attempts, it will push to DLQ",
      "fontSize": 19.078714504776187,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each topic will have retries and DLQ\nIf msg is not sent in 1st attempt, it will retry\nAfter all configured retry attempts, it will push to DLQ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vrRlddnVBSggVFe0JTlCo",
      "type": "text",
      "x": 1575.308855635792,
      "y": 1075.6962068865396,
      "width": 845.110022717561,
      "height": 23.848393130970233,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEK",
      "roundness": null,
      "seed": 1594388293,
      "version": 474,
      "versionNonce": 29108741,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767852596503,
      "link": null,
      "locked": false,
      "text": "Consider same operations being performed with every consumer inside every consumer group",
      "fontSize": 19.078714504776187,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consider same operations being performed with every consumer inside every consumer group",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
