    },
    {
      "id": "gQ7HpNOiwVH71IaU-pmgb",
      "type": "text",
      "x": 860.8084113176158,
      "y": 6064.523435483308,
      "width": 383.81976318359375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9V",
