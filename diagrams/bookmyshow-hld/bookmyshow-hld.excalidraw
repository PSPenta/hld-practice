      "updated": 1789050377652,
      "link": null,
      "locked": false,
      "text": "1. List all shows (search based on various filters)\n2. Admin can do CRUD on shows\n3. Users can see the show details and available seats\n4. Users can book the tickets",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. List all shows (search based on various filters)\n2. Admin can do CRUD on shows\n3. Users can see the show details and available seats\n4. Users can book the tickets",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
