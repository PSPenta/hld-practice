    {
      "id": "I__3z6L9Re8Y8oNu0piyt",
      "type": "text",
      "x": 66.02532383774883,
      "y": 1067.6545257200899,
      "width": 901.9393310546875,
      "height": 1100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
