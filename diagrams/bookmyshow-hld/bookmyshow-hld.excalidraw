      "boundElements": [],
      "updated": 1767123116347,
      "link": null,
      "locked": false,
      "text": "To handle the surge due to popular events\ni.e., a million users trying to book tickets\nThousands of parallel hits on the same category\nUsers can't select the seat initially.\nThey will get it once their payment is confirmed",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To handle the surge due to popular events\ni.e., a million users trying to book tickets\nThousands of parallel hits on the same category\nUsers can't select the seat initially.\nThey will get it once their payment is confirmed",
      "autoResize": true,
      "lineHeight": 1.25
    },
