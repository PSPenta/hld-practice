      "index": "b36",
      "roundness": null,
      "seed": 43449649,
      "version": 591,
      "versionNonce": 605264652,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767123116348,
      "link": null,
      "locked": false,
      "text": "1. GET /shows?name={name}&actors={actor}&time={time}&location={location}&term={term}\n    OR\n    GET /shows?q={term}\n    [{},{}]\n\n\n\n2. GET /shows/:id\n    {\n        id, name, time, location, actors, description, seats (booked and available)\n    }\n\n3. POST /shows\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n4. PUT /shows/:id\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n5. DELETE /shows/:id\n\n\n\n6. POST /booking/reserve\n    Headers: {\n        token: <JWT_user_token>\n    }\n    Input: {\n        showId,\n        seatNo\n    }\n\n7. POST /booking/confirm\n    Headers: {\n        token: <JWT_user_token>\n    }\n    Input: {\n        showId,\n        seatNo,\n        paymentDetails\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. GET /shows?name={name}&actors={actor}&time={time}&location={location}&term={term}\n    OR\n    GET /shows?q={term}\n    [{},{}]\n\n\n\n2. GET /shows/:id\n    {\n        id, name, time, location, actors, description, seats (booked and available)\n    }\n\n3. POST /shows\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n4. PUT /shows/:id\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n5. DELETE /shows/:id\n\n\n\n6. POST /booking/reserve\n    Headers: {\n        token: <JWT_user_token>\n    }\n    Input: {\n        showId,\n        seatNo\n    }\n\n7. POST /booking/confirm\n    Headers: {\n        token: <JWT_user_token>\n    }\n    Input: {\n        showId,\n        seatNo,\n        paymentDetails\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
