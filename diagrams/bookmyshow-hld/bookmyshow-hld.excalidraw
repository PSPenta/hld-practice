    {
      "id": "seTTACpAYnegeKtcFnQQw",
      "type": "text",
      "x": -328.1404190819128,
      "y": 521.4369109677316,
      "width": 901.9393310546875,
      "height": 850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b43",
      "roundness": null,
      "seed": 488226619,
      "version": 707,
      "versionNonce": 1344751259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789050377652,
      "link": null,
      "locked": false,
      "text": "1. GET /shows?name={name}&actors={actor}&time={time}&location={location}&term={term}\n    OR\n    GET /shows?q={term}\n\n2. GET /shows/:id\n    {\n        id, name, time, location, actors, description, seats (booked and available)\n    }\n\n3. POST /shows\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n4. PUT /shows/:id\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n5. DELETE /shows/:id\n\n\n\n6. POST /booking/reserve\n    Input: {\n        showId,\n        seatNo[]\n    }\n\n7. POST /booking/confirm\n    Input: {\n        bookingId,\n        paymentDetails\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. GET /shows?name={name}&actors={actor}&time={time}&location={location}&term={term}\n    OR\n    GET /shows?q={term}\n\n2. GET /shows/:id\n    {\n        id, name, time, location, actors, description, seats (booked and available)\n    }\n\n3. POST /shows\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n4. PUT /shows/:id\n    Input: {\n        id, name, time, location, actors, description\n    }\n\n5. DELETE /shows/:id\n\n\n\n6. POST /booking/reserve\n    Input: {\n        showId,\n        seatNo[]\n    }\n\n7. POST /booking/confirm\n    Input: {\n        bookingId,\n        paymentDetails\n    }",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
