      "boundElements": [],
      "updated": 1768504705525,
      "link": null,
      "locked": false,
      "text": "1. GET /timeline\n2. GET /posts/:id\n3. POST /posts\n4. PUT /posts/:id\n5. DELETE /posts/:id\n6. POST /posts/:id/comment\n7. POST /follow/:userId\n8. POST /unfollow/:userId\n9. GET /search?q=<text>",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. GET /timeline\n2. GET /posts/:id\n3. POST /posts\n4. PUT /posts/:id\n5. DELETE /posts/:id\n6. POST /posts/:id/comment\n7. POST /follow/:userId\n8. POST /unfollow/:userId\n9. GET /search?q=<text>",
      "autoResize": true,
      "lineHeight": 1.25
