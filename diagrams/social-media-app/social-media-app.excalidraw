      "isDeleted": false,
      "boundElements": [],
      "updated": 1768502980828,
      "link": null,
      "locked": false,
      "text": "Non-functional Requirements",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional Requirements",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9CJcjijQjS5A-X9Yo_eVK",
      "type": "text",
      "x": 42.69472144090469,
      "y": 750.4219308452302,
      "width": 641.4395751953125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGY",
      "roundness": null,
      "seed": 1602253596,
      "version": 389,
      "versionNonce": 1107346460,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768503032728,
      "link": null,
      "locked": false,
      "text": "1. Low latency in timeline refresh and search.\n2. High availability in posts CRUD and reply/comment.\n3. Eventual consistency in timeline.\n4. System should scale to high fan-out users (e.g., celebrities).\n5. System should tolerate partial failures without blocking writes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency in timeline refresh and search.\n2. High availability in posts CRUD and reply/comment.\n3. Eventual consistency in timeline.\n4. System should scale to high fan-out users (e.g., celebrities).\n5. System should tolerate partial failures without blocking writes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
